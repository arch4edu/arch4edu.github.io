---
import Base from '../layouts/Base.astro';
---

<Base title="Home - arch4edu">
  <div class="intro-page">
    <section class="intro-hero">
      <div class="intro-hero-brand">
        <img src="/logo.jpg" alt="arch4edu logo" class="intro-logo" />
        <img src="/arch4edu-text.svg" alt="arch4edu" class="intro-title-svg" />
      </div>
      <p class="intro-subtitle">Making your Arch Linux better for learning and researching.</p>
      <div class="intro-badges">
        <span class="badge-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          663 stars
        </span>
        <span class="badge-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
          49 forks
        </span>
        <span class="badge-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          <a href="https://github.com/arch4edu/arch4edu" target="_blank" rel="noopener">Repository</a>
        </span>
      </div>
    </section>

    <section class="intro-section">
      <h3>What is arch4edu?</h3>
      <p>Arch4edu is a community repository for <strong>Arch Linux</strong> and <strong>Arch Linux ARM</strong> that strives to provide the latest versions of most software used by college students.</p>
      <p>Please visit the <a href="https://github.com/arch4edu/arch4edu/wiki" target="_blank" rel="noopener">wiki</a> for more information.</p>
    </section>

    <section class="intro-section">
      <h3>Usage</h3>
      <ul class="intro-list">
        <li><a href="https://github.com/arch4edu/arch4edu/wiki/Add-arch4edu-to-your-Archlinux" target="_blank" rel="noopener">Add arch4edu to your Arch Linux</a></li>
        <li><a href="https://github.com/arch4edu/arch4edu/wiki/Add-a-package-to-arch4edu" target="_blank" rel="noopener">Add a package to arch4edu</a></li>
      </ul>
    </section>

    <section class="intro-section">
      <h3>Related Projects</h3>
      <div class="project-card">
        <h4><a href="https://github.com/arch4edu/cactus" target="_blank" rel="noopener">arch4edu/cactus</a></h4>
        <p>Build system that automates package building and publishing for the arch4edu repository.</p>
      </div>
      <div class="project-card">
        <h4><a href="https://github.com/arch4edu/aur-auto-update" target="_blank" rel="noopener">arch4edu/aur-auto-update</a></h4>
        <p>Automatically updates packages on AUR when new versions are available.</p>
      </div>
    </section>

    <section class="intro-section">
      <h3>Community</h3>
      <div class="community-grid">
        <a href="https://arch4edu.org" target="_blank" rel="noopener" class="community-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          Homepage
        </a>
        <a href="https://twitter.com/arch4edu" target="_blank" rel="noopener" class="community-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
          Twitter
        </a>
        <a href="https://t.me/arch4edu" target="_blank" rel="noopener" class="community-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.198 2.433a2.242 2.242 0 0 0-1.022.215l-8.609 3.33c-2.068.8-4.133 1.598-5.724 2.21a405.15 405.15 0 0 1-2.849 1.09c-.42.147-.99.332-1.473.901-.728.855.044 1.638.467 1.965.378.292.895.534 1.245.67l3.288 1.265c.3.897.6 1.794.9 2.69.233.476.676.867 1.211.867.396 0 .765-.157 1.047-.403l2.125-1.86 3.57 2.724c.193.148.405.26.63.336.225.076.46.116.701.116.75 0 1.387-.424 1.713-1.037.195-.368.299-.856.381-1.32l2.19-12.677c.137-.6.137-1.15-.102-1.628a1.803 1.803 0 0 0-1.688-.856z"/></svg>
          Telegram Channel
        </a>
        <a href="https://t.me/arch4edu_general" target="_blank" rel="noopener" class="community-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Telegram Group
        </a>
        <a href="https://matrix.to/#/#arch4edu-general:libera.chat" target="_blank" rel="noopener" class="community-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M7 7h10v10"/><path d="M7 17L17 7"/></svg>
          Matrix
        </a>
        <a href="ircs://irc.libera.chat/#arch4edu-general" class="community-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          IRC
        </a>
      </div>
    </section>

    <section class="intro-section traffic-map" id="traffic-map">
      <h3>Traffic by Country / Region</h3>
      <div class="map-body">
        <div class="map-wrap" id="map-wrap">
          <div id="gl-map"></div>
          <div class="map-tooltip" id="map-tooltip"></div>
        </div>
      </div>
      <div class="map-legend">
        <span class="legend-label">Less</span>
        <div class="legend-steps">
          <span class="legend-step"></span>
          <span class="legend-step"></span>
          <span class="legend-step"></span>
          <span class="legend-step"></span>
          <span class="legend-step"></span>
        </div>
        <span class="legend-label">More</span>
      </div>
      <ul class="map-notes" id="map-notes">
        <li>Data covers the last <span id="map-days">7</span> days of traffic to <code>repository.arch4edu.org</code> only.</li>
        <li>Sourced from Cloudflare Analytics. Country / Region labels are provided by Cloudflare and do not represent the views or positions of arch4edu.</li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .intro-page {
    max-width: none;
    margin: 0;
  }

  .traffic-map {
    position: relative;
  }

  .map-body {
    display: flex;
  }

  .map-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    aspect-ratio: 1264 / 440;
  }

  :global(#gl-map) {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
  }

  :global(#gl-map .maplibregl-ctrl-attrib),
  :global(#gl-map .mapboxgl-ctrl-attrib) {
    font-size: 10px;
    background: rgba(0,0,0,0.5);
    color: #aaa;
  }

  :global(#gl-map .maplibregl-ctrl-attrib a),
  :global(#gl-map .mapboxgl-ctrl-attrib a) {
    color: #ccc;
  }

  .map-legend {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
    justify-content: center;
  }

  .legend-label {
    font-size: 0.6rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .legend-steps {
    display: flex;
    gap: 2px;
  }

  .legend-step {
    width: 18px;
    height: 8px;
    border-radius: 1px;
  }

  .legend-step:nth-child(1) { background: #e0f2fe; }
  .legend-step:nth-child(2) { background: #7dd3fc; }
  .legend-step:nth-child(3) { background: #38bdf8; }
  .legend-step:nth-child(4) { background: #0284c7; }
  .legend-step:nth-child(5) { background: #075985; }

  :global([data-theme="dark"]) .legend-step:nth-child(1) { background: #082f49; }
  :global([data-theme="dark"]) .legend-step:nth-child(2) { background: #075985; }
  :global([data-theme="dark"]) .legend-step:nth-child(3) { background: #0284c7; }
  :global([data-theme="dark"]) .legend-step:nth-child(4) { background: #0ea5e9; }
  :global([data-theme="dark"]) .legend-step:nth-child(5) { background: #38bdf8; box-shadow: 0 0 4px rgba(56, 189, 248, 0.6); }

  .map-tooltip {
    display: none;
    position: absolute;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0;
    font-size: 0.75rem;
    color: var(--text-primary);
    pointer-events: none;
    white-space: nowrap;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    z-index: 10;
    overflow: hidden;
  }

  .map-notes {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
  }

  .map-notes li {
    font-size: 0.65rem;
    color: var(--text-muted);
    line-height: 1.6;
    padding: 0.15rem 0;
  }

  .map-notes li::before {
    content: "\2022";
    margin-right: 0.4rem;
    color: var(--text-muted);
    opacity: 0.5;
  }

  .map-notes code {
    font-size: 0.6rem;
    background: var(--bg-tertiary);
    padding: 0.05rem 0.25rem;
    border-radius: 2px;
  }

  .intro-hero {
    text-align: center;
    padding: 2.5rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .intro-hero-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .intro-logo {
    width: 64px;
    height: 64px;
    border-radius: 12px;
  }

  .intro-title-svg {
    height: 2.5rem;
    width: auto;
  }

  :global([data-theme="dark"]) .intro-title-svg {
    filter: brightness(0) invert(1);
  }

  .intro-subtitle {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 1.25rem;
  }

  .intro-badges {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .badge-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
  }

  .badge-item a {
    color: var(--accent);
  }

  .intro-section {
    margin-bottom: 2rem;
  }

  .intro-section h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
  }

  .intro-section p {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .intro-list {
    list-style: none;
    padding: 0;
  }

  .intro-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--bg-tertiary);
  }

  .intro-list li:last-child {
    border-bottom: none;
  }

  .intro-list li::before {
    content: "\2192";
    margin-right: 0.5rem;
    color: var(--accent);
  }

  .project-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
    transition: border-color 0.15s;
  }

  .project-card:hover {
    border-color: var(--accent);
  }

  .project-card h4 {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .project-card p {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .community-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.6rem;
  }

  .community-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 0.8rem;
    transition: border-color 0.15s, color 0.15s;
    text-decoration: none;
  }

  .community-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .intro-hero {
      padding: 1.5rem 0 1.25rem;
    }

    .intro-logo {
      width: 60px;
    }

    .intro-title-svg {
      height: 1.8rem;
    }

    .community-grid {
      grid-template-columns: 1fr 1fr;
    }

    .map-legend {
      margin-top: 0.4rem;
    }

    .legend-step {
      width: 14px;
      height: 6px;
    }

    .legend-label {
      font-size: 0.55rem;
    }
  }
</style>

<script>
  // --- Traffic Map (MapLibre GL) ---
  const TRAFFIC_URL = 'https://api.arch4edu.org/status/traffic.json';
  const GEOJSON_URL = '/countries.geo.json';

  function isDark(): boolean {
    return document.documentElement.getAttribute('data-theme') === 'dark';
  }

  function mapStyle(): string {
    return isDark()
      ? 'https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json'
      : 'https://basemaps.cartocdn.com/gl/positron-gl-style/style.json';
  }

  function noTrafficColor(): string {
    return isDark() ? 'rgba(30,41,59,0.45)' : 'rgba(203,213,225,0.45)';
  }

  function borderPaint(): Record<string, unknown> {
    return { 'line-color': isDark() ? 'rgba(71,85,105,0.4)' : 'rgba(148,163,184,0.45)', 'line-width': 0.4 };
  }

  function fillPaint(): Record<string, unknown> {
    return {
      'fill-color': [
        'interpolate', ['linear'], ['get', 'ratio'],
        0, noTrafficColor(),
        0.05, isDark() ? '#082f49' : '#e0f2fe',
        0.2, isDark() ? '#075985' : '#7dd3fc',
        0.45, isDark() ? '#0284c7' : '#38bdf8',
        0.75, isDark() ? '#0ea5e9' : '#0284c7',
        1.0, isDark() ? '#38bdf8' : '#075985',
      ],
      'fill-opacity': 0.85,
    };
  }

  function addLayers(map: any, geoData: any) {
    if (!map.getSource('countries')) {
      map.addSource('countries', { type: 'geojson', data: geoData });
    }
    map.addLayer({
      id: 'country-fill', type: 'fill', source: 'countries',
      paint: fillPaint(),
    });
    map.addLayer({
      id: 'country-border', type: 'line', source: 'countries',
      paint: borderPaint(),
    });
    map.addLayer({
      id: 'country-highlight', type: 'line', source: 'countries',
      paint: { 'line-color': '#38bdf8', 'line-width': 1.5 },
      filter: ['==', ['get', 'iso_a2'], ''],
    });
  }

  async function initTrafficMap() {
    const mapEl = document.getElementById('gl-map');
    const tooltip = document.getElementById('map-tooltip')!;

    if (!mapEl || !(window as any).maplibregl) {
      setTimeout(initTrafficMap, 300);
      return;
    }

    const ml = (window as any).maplibregl;

    try {
      const [geoData, trafficResp] = await Promise.all([
        fetch(GEOJSON_URL).then(r => r.json()),
        fetch(TRAFFIC_URL).then(r => r.json()),
      ]);

      // Build alpha-2 code -> percent lookup (backend now emits percent with 3 decimals)
      const codeToPercent: Record<string, number> = {};
      for (const c of trafficResp.countries) {
        const code = String(c.country || '').toLowerCase();
        codeToPercent[code] = (codeToPercent[code] || 0) + (c.percent || 0);
      }

      const maxPct = Math.max(...trafficResp.countries.map((c: any) => c.percent || 0), 0.001);

      // Match GeoJSON features by iso_a2 property
      for (const feature of geoData.features) {
        const a2 = feature.properties.iso_a2 || '';
        const pct = codeToPercent[a2] || 0;
        feature.properties.percent = pct;
        feature.properties.ratio = pct > 0 ? Math.sqrt(pct / maxPct) : 0;
      }

      document.getElementById('map-days')!.textContent = String(trafficResp.days || 7);

      const map = new ml.Map({
        container: 'gl-map',
        style: mapStyle(),
        center: [10, 20],
        zoom: 1.2,
        minZoom: 1,
        maxZoom: 6,
        attributionControl: true,
        dragRotate: false,
        pitchWithRotate: false,
      });

      map.addControl(new ml.NavigationControl({ showCompass: false }), 'bottom-right');
      map.resize();

      map.on('load', () => {
        map.resize();
        addLayers(map, geoData);

        let hoveredId = '';

        map.on('mousemove', 'country-fill', (e: any) => {
          map.getCanvas().style.cursor = 'pointer';
          const props = e.features[0].properties;
          const id = props.iso_a2;

          if (id !== hoveredId) {
            hoveredId = id;
            map.setFilter('country-highlight', ['==', ['get', 'iso_a2'], id]);
          }

          const name = props.name;
          if (props.percent > 0) {
            tooltip.innerHTML = `${name} ${props.percent.toFixed(3)}%`;
          } else {
            tooltip.innerHTML = `${name}`;
          }
          tooltip.style.display = 'block';

          const rect = mapEl.closest('.traffic-map')!.getBoundingClientRect();
          tooltip.style.left = (e.originalEvent.clientX - rect.left + 14) + 'px';
          tooltip.style.top = (e.originalEvent.clientY - rect.top - 36) + 'px';
        });

        map.on('mouseleave', 'country-fill', () => {
          map.getCanvas().style.cursor = '';
          tooltip.style.display = 'none';
          hoveredId = '';
          map.setFilter('country-highlight', ['==', ['get', 'iso_a2'], '']);
        });
      });

      const observer = new MutationObserver(() => {
        if (!map) return;
        map.setStyle(mapStyle());
        map.once('styledata', () => addLayers(map, geoData));
      });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    } catch (e) {
      console.error('Traffic map error:', e);
      mapEl.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted);font-size:0.8rem;">Map unavailable</div>';
    }
  }

  initTrafficMap();
</script>
